# Copy to .env and fill in. docker compose reads it automatically.

# HuggingFace token with access to the gated facebook/sam3 repo (needed for sam_v3).
HF_TOKEN=

# Comma-separated models to load; the first is the default for requests without ?model=
# Options: sam_v1, sam_v2, sam_v3
SEG_MODELS=sam_v3

# Concurrency. Each model runs one inference at a time; pre/post-processing overlaps.
# Requests admitted per model (running + waiting); further requests get 429 + Retry-After.
SEGMENTOR_SERVER_MAX_QUEUE_PER_MODEL=16
# Max seconds an admitted request waits for its model; beyond that it gets 503 + Retry-After.
# (For a manual 429/503 test, use e.g. 2 and 0.3.)
SEGMENTOR_SERVER_REQUEST_TIMEOUT=30

# Comma-separated bearer tokens. Empty = no authentication (only for trusted networks).
SEG_API_KEYS=

# Host port, GPU index, compute settings
SEG_PORT=29086
SEG_GPU=0
SEG_DEVICE=cuda
SEG_PRECISION=fp16

# Upstream SAM3 git ref used at build time: "main" tracks latest, a commit SHA pins it.
SAM3_REF=main

# Any SEGMENTOR_<SECTION>_<FIELD> config override also works here, e.g.:
# SEGMENTOR_SERVER_MAX_IMAGE_SIZE_MB=20
# SEGMENTOR_THRESHOLDS_CONCEPT_CONFIDENCE_THRESHOLD=0.5
